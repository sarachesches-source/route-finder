# Copy this file to .env and fill in your own key. Never commit .env.
# Free key: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your-openrouteservice-key-here

# Optional, for a public site (limits are off in development unless set):
# SEARCHES_PER_HOUR=5          # real searches per visitor per hour
# DAILY_REQUEST_BUDGET=1500    # stop new searches after this many routing requests a day
# CACHE_DIR=/tmp/route-cache   # where saved answers go (default .cache, or a temp folder on Vercel)
